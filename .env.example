PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://core_user:change_me@localhost:5432/core_db
DATABASE_SSL=false
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Perfiles de demostración creados o actualizados al iniciar la aplicación
ADMIN_USERNAME=admin@core.local
